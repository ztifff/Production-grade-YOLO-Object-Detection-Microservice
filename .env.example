# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment Variable Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="YOLO Vision API"
APP_VERSION="1.0.0"

# Environment: development | staging | production
ENV=production

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ── Inference Engine ──────────────────────────────────────────────────────────
# Path to the YOLO model weights (.pt or .onnx).
# Download yolov8n.pt: https://github.com/ultralytics/assets/releases
MODEL_PATH=models/yolov8n.pt

# Minimum confidence score for a detection to be included (0.01 – 1.0)
YOLO_CONF=0.25

# IoU threshold for Non-Maximum Suppression (0.01 – 1.0)
YOLO_IOU=0.45

# Inference device: cpu | cuda | cuda:0 | mps
# Use 'cuda' for NVIDIA GPU, 'mps' for Apple Silicon, 'cpu' otherwise.
YOLO_DEVICE=cpu

# Maximum detections returned per image
YOLO_MAX_DET=300


# ── API Gateway ───────────────────────────────────────────────────────────────
# Maximum image upload size in bytes (default 10 MB = 10485760)
MAX_IMAGE_BYTES=10485760

# Comma-separated list of allowed CORS origins. Use * to allow all.
CORS_ORIGINS=*

# Number of Gunicorn worker processes
WORKERS=4

# Port the API listens on inside the container
PORT=8000

# Host port published on the Docker host (docker-compose only)
API_PORT=8000


# ── Security & Monetisation ───────────────────────────────────────────────────
# JSON object mapping raw API key strings to tenant metadata.
#
# Schema: {"<api_key>": {"client_id": "<id>", "tier": "free|premium|enterprise"}}
#
# Generate secure keys with:
#   python -c "import secrets; print('sk-' + secrets.token_hex(24))"
#
# Example (add as many keys as needed):
API_KEYS={"sk-free-REPLACE_ME": {"client_id": "demo-user", "tier": "free"}, "sk-prem-REPLACE_ME": {"client_id": "acme-corp", "tier": "premium"}, "sk-ent-REPLACE_ME": {"client_id": "enterprise-customer", "tier": "enterprise"}}


# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection URL
# In docker-compose, the hostname is the service name ('redis')
REDIS_URL=redis://localhost:6379/0

# Redis AUTH password — leave empty to disable authentication
# Set this in production! Generate with: openssl rand -hex 32
REDIS_PASSWORD=


# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Maximum requests per window for each billing tier
RATE_LIMIT_FREE=60
RATE_LIMIT_PREMIUM=5000
# Enterprise = 0 means unlimited
RATE_LIMIT_ENTERPRISE=0

# Sliding window duration in seconds
RATE_LIMIT_WINDOW_SECONDS=60
